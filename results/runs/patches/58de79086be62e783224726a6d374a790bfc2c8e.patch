-    seeds = sorted(set(after) & set(before))
-    diffs = [after[s] - before[s] for s in seeds
-             if after[s] is not None and before[s] is not None]
-    n = len(diffs)
-    if n == 0:
-        return {'n_pairs': 0, 'mean': None, 'ci': (None, None), 'sd': None,
